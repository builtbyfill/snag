# Copy to .env and fill in. Values starting with "replace-with-" are placeholders:
# the app refuses to start while one is left in. Never commit .env.

# Anthropic Console key (set a spend limit in the Console)
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Dashboard access code, 16+ characters; used for nothing else
ADMIN_SECRET=replace-with-an-access-code-of-16-or-more-characters
# Signs the session cookie only. Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-32-random-bytes
# HMAC key for reporter IP hashes only. Generate: openssl rand -base64 32
IP_HASH_SECRET=replace-with-32-random-bytes
# Used by the db, migrate and app containers
POSTGRES_PASSWORD=replace-with-a-postgres-password

# What "Copy report link" copies; https:// turns on the secure cookie
APP_URL=http://localhost:3000
# 127.0.0.1 on the server (Caddy in front)
APP_BIND=0.0.0.0
# true on the server: read the client IP from x-forwarded-for
TRUST_PROXY=false
# Host dev only; Compose overrides it with host "db"
DATABASE_URL=postgres://snag:replace-with-a-postgres-password@localhost:5432/snag
# Host dev only; Compose sets /data/uploads
UPLOAD_DIR=./.uploads

# Model and screenshot downscale limit (long edge in px)
EXTRACTION_MODEL=claude-sonnet-5-5
EXTRACTION_MAX_EDGE=1568
