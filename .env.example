# Copy to .env and fill in. Values starting with "replace-with-" are placeholders:
# the app refuses to start while one is left in. Never commit .env.

# Anthropic Console key (set a spend limit in the Console)
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Dashboard access code, 16+ characters; used for nothing else
ADMIN_SECRET=replace-with-an-access-code-of-16-or-more-characters
# Optional second code for judges (16+ characters, different from every secret here). Empty: off.
# Give it out instead of yours; remove it after judging and rotate SESSION_SECRET to end its sessions.
DEMO_ACCESS_CODE=
# Signs the session cookie only. Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-32-random-bytes
# HMAC key for reporter IP hashes only. Generate: openssl rand -base64 32
IP_HASH_SECRET=replace-with-32-random-bytes
# Used by the db, migrate and app containers
POSTGRES_PASSWORD=replace-with-a-postgres-password

# What "Copy report link" copies; https:// turns on the secure cookie
APP_URL=http://localhost:3000
# 127.0.0.1 on the server (Caddy in front)
APP_BIND=0.0.0.0
# Host dev only (port 5433, see docker-compose.yml); Compose overrides it with host "db"
DATABASE_URL=postgres://snag:replace-with-a-postgres-password@localhost:5433/snag
# Host dev only; Compose sets /data/uploads. Ignored when the two SUPABASE_ variables below are set
UPLOAD_DIR=./.uploads

# --- Vercel + Supabase only (docs/deploy.md). Leave all four empty for Compose and host dev. ---
# Migrations and the seed only: Supabase's session pooler (port 5432). Empty: they use DATABASE_URL
DIRECT_URL=
# Supabase's CA certificate (PEM; one line with \n escapes is fine) for verified TLS. Required on Vercel
DATABASE_SSL_CA=
# Both set: screenshots go to the private "screenshots" bucket; both empty: local disk (UPLOAD_DIR)
SUPABASE_URL=
# Supabase secret key (sb_secret_…, or a legacy service_role key). Server-only, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Model and screenshot downscale limit (long edge in px)
EXTRACTION_MODEL=claude-sonnet-5-5
EXTRACTION_MAX_EDGE=1568

# Optional: shown in the client page header and on its Contact card
DEVELOPER_NAME=
# Optional: a mailto link on the client page's Contact card
DEVELOPER_EMAIL=
